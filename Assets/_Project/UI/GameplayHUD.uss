/* ========================================
   EXTERMINATOR GAME - INDUSTRIAL HUD
   Theme: "Company Safety Manual" + "Retro Terminal"
   Colors: Safety Yellow, Hazard Orange, Industrial Grey
   ======================================== */

/* ========================================
   COLOR PALETTE (CSS Variables)
   ======================================== */
:root {
    /* Safety Colors */
    --safety-yellow: rgb(255, 215, 0);
    --hazard-orange: rgb(255, 120, 0);
    --caution-red: rgb(220, 50, 50);
    
    /* Industrial Colors */
    --concrete-grey: rgb(60, 60, 65);
    --metal-dark: rgb(35, 35, 40);
    --metal-light: rgb(80, 80, 85);
    
    /* UI Colors */
    --bg-panel: rgba(25, 25, 30, 0.9);
    --border-color: rgb(120, 120, 125);
    --text-primary: rgb(240, 240, 240);
    --text-dim: rgb(180, 180, 185);
    
    /* Bar Colors */
    --health-color: rgb(80, 220, 120);
    --health-low: rgb(220, 50, 50);
    --xp-color: rgb(100, 180, 255);
    
    /* Sizes */
    --border-width: 2px;
    --corner-radius: 4px;
    --panel-padding: 16px;
}

/* ========================================
   ROOT & LAYOUT
   ======================================== */
.hud-root {
    width: 100%;
    height: 100%;
    position: absolute;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
}

/* ========================================
   CORNER PANELS (Health, Level, Room)
   ======================================== */
.corner-panel {
    background-color: var(--bg-panel);
    border-color: var(--border-color);
    border-width: var(--border-width);
    border-radius: var(--corner-radius);
    padding: var(--panel-padding);
    margin: 20px;
    min-width: 220px;
    pointer-events: auto;
    box-shadow: 0 4px 8px rgba(0,0,0,0.5);
}

.corner-panel-top-left {
    position: absolute;
    top: 0;
    left: 0;
}

.corner-panel-top-right {
    position: absolute;
    top: 0;
    right: 0;
    align-items: flex-end;
}

/* ========================================
   BOTTOM PANEL (XP Bar)
   ======================================== */
.bottom-panel {
    position: absolute;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    background-color: var(--bg-panel);
    border-color: var(--border-color);
    border-width: var(--border-width);
    border-radius: var(--corner-radius);
    padding: 15px 25px;
    margin-bottom: 20px;
    min-width: 450px;
    align-items: center;
    pointer-events: auto;
    box-shadow: 0 -4px 8px rgba(0,0,0,0.5);
}

/* ========================================
   STAT CONTAINERS
   ======================================== */
.stat-container {
    margin-bottom: 12px;
    flex-direction: column;
}

.xp-stat-container {
    margin-bottom: 0;
    width: 100%;
}

/* ========================================
   LABELS (Safety Manual Style)
   ======================================== */
.stat-label {
    font-size: 12px;
    color: var(--text-dim);
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 6px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.8);
    text-transform: uppercase;
}

.safety-label {
    color: var(--safety-yellow);
}

.xp-label {
    text-align: center;
    margin-bottom: 8px;
}

/* ========================================
   BAR CONTAINERS (Health, XP)
   ======================================== */
.bar-container {
    height: 28px;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    border-width: 1px;
    border-color: var(--metal-light);
    background-color: var(--metal-dark);
}

.xp-bar-container {
    width: 100%;
    height: 24px;
}

.bar-background {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: var(--concrete-grey);
}

.bar-fill {
    position: absolute;
    height: 100%;
    transition-duration: 0.3s;
    transition-property: width;
    transition-timing-function: ease-out;
}

.health-bar-fill {
    background-color: var(--health-color);
    box-shadow: 0 0 12px rgba(80, 220, 120, 0.6);
}

.xp-bar-fill {
    background-color: var(--xp-color);
    box-shadow: 0 0 10px rgba(100, 180, 255, 0.5);
}

.bar-text {
    position: absolute;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: var(--text-primary);
    -unity-font-style: bold;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
}

/* ========================================
   LEVEL DISPLAY (Big Number Style)
   ======================================== */
.level-value {
    font-size: 56px;
    color: var(--safety-yellow);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.8);
    margin-top: -10px;
    letter-spacing: -2px;
}

/* ========================================
   ROOM & ENEMY COUNTERS
   ======================================== */
.room-value,
.enemies-value {
    font-size: 32px;
    color: var(--text-primary);
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
    -unity-text-align: middle-right;
}

.enemies-value {
    color: var(--hazard-orange);
}

/* ========================================
   NOTIFICATION PANEL (Center Screen)
   ======================================== */
.notification-panel {
    position: absolute;
    top: 30%;
    left: 50%;
    translate: -50% -50%;
    opacity: 0;
    transition-duration: 0.5s;
    transition-property: opacity;
}

.notification-text {
    font-size: 42px;
    color: var(--safety-yellow);
    -unity-font-style: bold;
    text-shadow: 4px 4px 8px rgba(0, 0, 0, 0.9);
    letter-spacing: 3px;
    padding: 24px 48px;
    background-color: rgba(0, 0, 0, 0.85);
    border-color: var(--safety-yellow);
    border-width: 4px;
    border-radius: 6px;
    text-transform: uppercase;
}

/* Show notification when needed (toggle with .visible class) */
.notification-panel.visible {
    opacity: 1;
}

/* ========================================
   HEALTH BAR LOW HP WARNING
   ======================================== */
.health-bar-fill.low-health {
    background-color: var(--health-low);
    box-shadow: 0 0 20px rgba(220, 50, 50, 0.9);
}

/* ========================================
   RESPONSIVE ADJUSTMENTS (For different resolutions)
   ======================================== */
/* Note: UI Toolkit doesn't have media queries, but we can adjust via script */
