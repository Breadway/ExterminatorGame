/* ========================================
   INDUSTRIAL THEME - shared palette and parts
   Used by the upgrade review and run end screens.
   Palette matches the "Safety" palette in GAMEDESIGN.md.
   Unity USS has no text-transform, box-shadow or gap, so labels are written in
   capitals in the UXML/code and shadows are drawn with extra elements.
   ======================================== */

:root {
    --safety-yellow: rgb(255, 204, 0);
    --hazard-orange: rgb(255, 120, 0);
    --rust-red: rgb(140, 50, 40);
    --alarm-red: rgb(235, 80, 70);
    --toxic-purple: rgb(180, 60, 220);
    --chem-green: rgb(80, 215, 120);

    --concrete-grey: rgb(80, 80, 85);
    --terminal-bg: rgba(10, 12, 15, 0.97);
    --card-bg: rgb(22, 26, 30);

    --text-primary: rgb(230, 230, 230);
    --text-dim: rgb(150, 150, 155);
}

.industrial {
    -unity-font-definition: url("../Art/Fonts/ShareTechMono-Regular.ttf");
    color: var(--text-primary);
}

/* Fullscreen dim layer. Hidden until the controller adds "shown", then "visible"
   one frame later so the fade and slide transitions run. */
.screen-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 5, 6, 0);
    transition-property: background-color;
    transition-duration: 0.25s;
}

.screen-root.shown {
    display: flex;
}

.screen-root.visible {
    background-color: rgba(4, 5, 6, 0.84);
}

.form-sheet {
    background-color: var(--terminal-bg);
    border-color: var(--concrete-grey);
    border-width: 3px;
    opacity: 0;
    translate: 0 28px;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out;
}

.screen-root.visible .form-sheet {
    opacity: 1;
    translate: 0 0;
}

/* Caution tape strip. Segments are generated by HazardTape.Fill. */
.hazard-tape {
    width: 100%;
    height: 16px;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
    background-color: rgb(20, 20, 20);
}

.hazard-seg {
    width: 14px;
    height: 56px;
    margin-right: 18px;
    flex-shrink: 0;
    background-color: var(--safety-yellow);
    rotate: 35deg;
}

.form-line {
    font-size: 15px;
    color: var(--text-dim);
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.form-title {
    font-size: 58px;
    color: var(--safety-yellow);
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 3px 3px 0px rgba(0, 0, 0, 1);
}

.form-subtitle {
    font-size: 19px;
    color: var(--text-dim);
    margin-top: 6px;
}

.divider {
    height: 3px;
    background-color: var(--concrete-grey);
}

/* Gauge tick marks under a bar. Generated by GaugeTicks.Fill. */
.gauge-ticks {
    flex-direction: row;
    height: 7px;
    justify-content: space-between;
    margin-top: 2px;
}

.gauge-tick {
    width: 2px;
    height: 100%;
    background-color: rgba(150, 150, 155, 0.55);
}

.gauge-tick.major {
    width: 3px;
    background-color: rgba(255, 204, 0, 0.8);
}

/* ---- Scrollbars: dark track, safety-yellow thumb ---- */
.industrial .unity-scroller {
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 0;
}

.industrial .unity-base-slider__dragger {
    background-color: var(--safety-yellow);
    border-width: 0;
    border-radius: 0;
}

.industrial .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 0;
}

.industrial .unity-scroller__low-button,
.industrial .unity-scroller__high-button {
    display: none;
}

.industrial .unity-scroller--vertical {
    width: 8px;
}
