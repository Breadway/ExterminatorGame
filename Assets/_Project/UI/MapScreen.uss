/* Branching map: pick the next sector. Reuses the requisition-card language. */

.map-sheet {
    width: 1240px;
    max-width: 96%;
}

.map-body {
    padding: 30px 40px 26px 40px;
    align-items: center;
}

.map-title {
    font-size: 50px;
}

.map-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 24px;
    margin-bottom: 22px;
}

.map-card {
    width: 320px;
    min-height: 260px;
    margin-left: 12px;
    margin-right: 12px;
    background-color: var(--card-bg);
    border-width: 3px;
    border-color: var(--concrete-grey);
    transition-property: translate, border-color;
    transition-duration: 0.12s;
}

.map-card:hover {
    translate: 0 -8px;
    border-color: var(--safety-yellow);
}

.map-card-head {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--text-primary);
    white-space: normal;
    padding: 16px 18px 0 18px;
    text-shadow: 2px 2px 0px rgba(0, 0, 0, 1);
}

.map-card-type {
    font-size: 17px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    padding: 12px 18px 0 18px;
}

.map-card-desc {
    font-size: 16px;
    color: var(--text-dim);
    white-space: normal;
    padding: 10px 18px 18px 18px;
}

.map-type-combat { color: var(--text-primary); }
.map-type-elite { color: var(--alarm-red); }
.map-type-unknown { color: var(--toxic-purple); }
.map-type-shop { color: var(--chem-green); }
.map-type-boss { color: var(--hazard-orange); }
